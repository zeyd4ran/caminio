modules = ["nodejs-24", "postgresql-16", "python-base-3.13"]
[postMerge]
path = "Execstack=1/scripts/post-merge.mjs"
timeoutMs = 20000
[nix]
channel = "stable-25_05"
packages = ["unzip"]

